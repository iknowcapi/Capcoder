{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && yarn install --ignore-engines && yarn build",
  "outputDirectory": "frontend/build",
  "installCommand": "echo skip-root-install",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/neon-auth/:path*", "destination": "https://capcode-dun6.onrender.com/api/neon-auth/:path*" }
  ]
}
