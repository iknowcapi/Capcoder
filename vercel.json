{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build",
        "installCommand": "yarn install --ignore-engines --frozen-lockfile=false"
      }
    },
    {
      "src": "backend/server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/server.py" },
    { "src": "/(.*\\.(?:css|js|json|ico|png|jpg|jpeg|svg|webp|txt|map|woff|woff2|ttf))", "dest": "/frontend/build/$1" },
    { "src": "/(.*)", "dest": "/frontend/build/index.html" }
  ]
}
